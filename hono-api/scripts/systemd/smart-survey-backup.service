[Unit]
Description=Smart Survey X encrypted Postgres backup (adaptive cadence)
Documentation=file:/opt/smart-survey-x/scripts/BACKUP_SETUP.md
After=postgresql@18-main.service
Requires=postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/smart-survey-backup.env
ExecStart=/bin/bash /opt/smart-survey-x/scripts/backup-db.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=30min
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/smart-survey-x
NoNewPrivileges=true
