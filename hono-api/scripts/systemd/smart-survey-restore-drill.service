[Unit]
Description=Daily restore drill for Smart Survey X backups
After=postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
EnvironmentFile=/etc/smart-survey-backup.env
ExecStart=/bin/bash /opt/smart-survey-x/scripts/restore-drill.sh
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/backups/smart-survey-x
NoNewPrivileges=true
