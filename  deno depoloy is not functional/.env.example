# Neon
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Cloudflare R2 — election-survey-media
# API endpoint (S3):
#   https://6f54ac7c46cba07b9dac5e1548348f4f.r2.cloudflarestorage.com/election-survey-media
R2_ACCOUNT_ID=6f54ac7c46cba07b9dac5e1548348f4f
R2_ENDPOINT=https://6f54ac7c46cba07b9dac5e1548348f4f.r2.cloudflarestorage.com
R2_BUCKET=election-survey-media

# From R2 → Manage R2 API Tokens (Object Read & Write)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Public URL so browsers/app can open photos/audio
# Bucket Settings → R2.dev subdomain → Allow Access → copy https://pub-….r2.dev
R2_PUBLIC_URL=
